        <!-- Nguồn Lead cho thí sinh tự đăng ký trên cổng portal -->
        <record id="crm_source_portal" model="eaut.crm.source">
            <field name="name">Cổng thông tin tuyển sinh (Portal)</field>
        </record>
    </data>
</odoo>
