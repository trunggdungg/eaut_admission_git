<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_admission_letter" model="ir.actions.report">
        <field name="name">Giấy xác nhận nhập học</field>
        <field name="model">eaut.admission.application</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">eaut_admission.report_admission_letter</field>
        <field name="report_file">eaut_admission.report_admission_letter</field>
        <field name="print_report_name">'Giay-xac-nhan-nhap-hoc-%s' % (object.name)</field>
    </record>

    <template id="report_admission_letter">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2 class="text-center">GIẤY XÁC NHẬN NHẬP HỌC</h2>
                        <p class="text-center">Mã hồ sơ: <strong t-field="o.name"/></p>
                        <p>
                            Nhà trường xác nhận thí sinh <strong t-field="o.full_name"/>,
                            sinh ngày <span t-field="o.date_of_birth"/>,
                            số căn cước công dân <span t-field="o.id_number"/>,
                            đã được chấp nhận hồ sơ xét tuyển thuộc <span t-field="o.campaign_id.name"/>
                            và đã hoàn thành nghĩa vụ học phí.
                        </p>
                        <h5>Nguyện vọng xét tuyển</h5>
                        <table class="table table-sm">
                            <thead>
                                <tr><th>NV</th><th>Ngành</th><th>Phương thức</th><th>Tổ hợp</th></tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="o.choice_ids.sorted('priority')" t-as="c">
                                    <td><span t-field="c.priority"/></td>
                                    <td><span t-field="c.program_id.name"/></td>
                                    <td><span t-field="c.method_id.name"/></td>
                                    <td><span t-field="c.combination_id.name"/></td>
                                </tr>
                            </tbody>
                        </table>
                        <p>Ngày đóng học phí: <span t-field="o.payment_date"/> - Mã biên lai: <span t-field="o.payment_reference"/></p>
                        <p>Thí sinh đã được xác nhận đỗ tốt nghiệp THPT.</p>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>