<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_admission" model="res.groups.privilege">
        <field name="name">Tuyển sinh</field>
        <field name="sequence">30</field>
        <field name="category_id" ref="base.module_category_services"/>
    </record>

    <!-- Cán bộ phòng đào tạo: xem và xử lý hồ sơ. Admin được gán sẵn để thấy menu ngay sau khi cài -->
    <record id="group_admission_officer" model="res.groups">
        <field name="name">Cán bộ phòng đào tạo</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_admission"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
