<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Danh sách đợt tuyển sinh đang mở -->
    <template id="admission_apply_list" name="Tuyển sinh: chọn đợt đăng ký">
        <t t-call="portal.portal_layout">
            <div class="container py-5" style="max-width: 720px;">
                <h1 class="h3 mb-4">Đăng ký xét tuyển</h1>
                <div t-if="not campaigns" class="alert alert-info">
                    Hiện chưa có đợt tuyển sinh nào đang mở nhận hồ sơ.
                </div>
                <div class="list-group">
                    <a t-foreach="campaigns" t-as="c"
                       t-attf-href="/admission/apply/#{c.admission_form_ids.filtered('active')[:1].token}"
                       class="list-group-item list-group-item-action">
                        <strong t-out="c.name"/> <span class="text-muted">(<t t-out="c.year"/>)</span>
                    </a>
                </div>
            </div>
        </t>
    </template>

    <template id="admission_apply_closed" name="Tuyển sinh: form đã đóng">
        <t t-call="portal.portal_layout">
            <div class="container py-5 text-center" style="max-width: 620px;">
                <div class="alert alert-warning">Form đăng ký này hiện không còn nhận hồ sơ.</div>
                <a href="/admission/apply">Xem các đợt tuyển sinh đang mở</a>
            </div>
        </t>
    </template>

    <!-- Form nộp hồ sơ -->
    <template id="admission_apply_form" name="Tuyển sinh: form nộp hồ sơ">
        <t t-call="portal.portal_layout">
            <div class="container o_admission_apply_page py-5" style="max-width: 860px;">
                <div class="card shadow-sm border-0" style="border-radius: 16px;">
                    <div class="card-body p-4 p-md-5">
                        <h1 class="h3 mb-1" t-out="form.website_title or 'Đăng ký xét tuyển'"/>
                        <p class="text-muted mb-1" t-out="form.website_description"/>
                        <p class="text-muted mb-4" t-out="form.campaign_id.name"/>
                        <div t-if="error" class="alert alert-danger" role="alert" t-out="error"/>

                        <form t-attf-action="/admission/apply/#{form.token}/submit" method="post"
                              enctype="multipart/form-data">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <div style="position:absolute; left:-9999px;" aria-hidden="true">
                                <input type="text" name="website_url" tabindex="-1" autocomplete="off"/>
                            </div>

                            <h2 class="h5 mb-3">1. Thông tin cá nhân</h2>
                            <div class="row g-3 mb-4">
                                <div class="col-md-6">
                                    <label class="form-label" for="full_name">Họ và tên *</label>
                                    <input type="text" class="form-control" id="full_name" name="full_name"
                                           t-att-value="vals.get('full_name')" required="required"/>
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label" for="date_of_birth">Ngày sinh</label>
                                    <input type="date" class="form-control" id="date_of_birth" name="date_of_birth"
                                           t-att-value="vals.get('date_of_birth')"/>
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label" for="gender">Giới tính</label>
                                    <select class="form-select" id="gender" name="gender">
                                        <option value="">--</option>
                                        <option value="male" t-att-selected="vals.get('gender') == 'male'">Nam</option>
                                        <option value="female" t-att-selected="vals.get('gender') == 'female'">Nữ</option>
                                        <option value="other" t-att-selected="vals.get('gender') == 'other'">Khác</option>
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label" for="phone">Số điện thoại *</label>
                                    <input type="tel" class="form-control" id="phone" name="phone"
                                           t-att-value="vals.get('phone')" pattern="[0-9+]{10,12}" required="required"/>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label" for="email">Email *</label>
                                    <input type="email" class="form-control" id="email" name="email"
                                           t-att-value="vals.get('email')" required="required"/>
                                </div>
                                <div class="col-md-8">
                                    <label class="form-label" for="school_name">Trường THPT</label>
                                    <input type="text" class="form-control" id="school_name" name="school_name"
                                           t-att-value="vals.get('school_name')"/>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label" for="graduation_year">Năm tốt nghiệp</label>
                                    <input type="number" class="form-control" id="graduation_year" name="graduation_year"
                                           t-att-value="vals.get('graduation_year')"/>
                                </div>
                                <div class="col-12">
                                    <label class="form-label" for="address">Địa chỉ liên hệ</label>
                                    <input type="text" class="form-control" id="address" name="address"
                                           t-att-value="vals.get('address')"/>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label" for="id_number">Số căn cước công dân (12 số)</label>
                                    <input type="text" class="form-control" id="id_number" name="id_number"
                                           t-att-value="vals.get('id_number')" pattern="[0-9]{12}"/>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label" for="id_issue_date">Ngày cấp</label>
                                    <input type="date" class="form-control" id="id_issue_date" name="id_issue_date"
                                           t-att-value="vals.get('id_issue_date')"/>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label" for="id_issue_place">Nơi cấp</label>
                                    <input type="text" class="form-control" id="id_issue_place" name="id_issue_place"
                                           t-att-value="vals.get('id_issue_place')"/>
                                </div>
                                <div class="col-12">
                                    <label class="form-label" for="vneid_account">Tài khoản VNeID (số định danh cá nhân)</label>
                                    <input type="text" class="form-control" id="vneid_account" name="vneid_account"
                                           t-att-value="vals.get('vneid_account')"/>
                                </div>
                            </div>

                            <h2 class="h5 mb-3">2. Nguyện vọng xét tuyển</h2>
                            <div class="mb-4">
                                <div t-foreach="choice_numbers" t-as="n" class="row g-2 mb-2">
                                    <div class="col-md-4">
                                        <select t-attf-name="program_id_#{n}" class="form-select">
                                            <option value="">Nguyện vọng <t t-out="n"/>: ngành học</option>
                                            <option t-foreach="programs" t-as="p" t-att-value="p.id"
                                                    t-att-selected="vals.get('program_id_%s' % n) == str(p.id)">
                                                <t t-out="p.name"/> (<t t-out="p.code"/>)
                                            </option>
                                        </select>
                                    </div>
                                    <div class="col-md-4">
                                        <select t-attf-name="method_id_#{n}" class="form-select">
                                            <option value="">Phương thức xét tuyển</option>
                                            <option t-foreach="methods" t-as="m" t-att-value="m.id" t-out="m.name"
                                                    t-att-selected="vals.get('method_id_%s' % n) == str(m.id)"/>
                                        </select>
                                    </div>
                                    <div class="col-md-4">
                                        <select t-attf-name="combination_id_#{n}" class="form-select">
                                            <option value="">Tổ hợp (nếu có)</option>
                                            <option t-foreach="combinations" t-as="c" t-att-value="c.id" t-out="c.name"
                                                    t-att-selected="vals.get('combination_id_%s' % n) == str(c.id)"/>
                                        </select>
                                    </div>
                                </div>
                            </div>

                            <h2 class="h5 mb-3">3. Tài liệu</h2>
                            <div class="mb-4">
                                <div t-foreach="doc_types" t-as="dt" class="mb-3">
                                    <label class="form-label" t-attf-for="file_#{dt[0]}">
                                        <t t-out="dt[1]"/>
                                        <span t-if="dt[0] in required_doc_types" class="text-danger">*</span>
                                    </label>
                                    <input type="file" class="form-control" multiple="multiple"
                                           t-attf-id="file_#{dt[0]}" t-attf-name="file_#{dt[0]}"
                                           t-att-accept="allowed_extensions"/>
                                </div>
                                <div class="form-text">
                                    Định dạng <t t-out="allowed_extensions"/>, tối đa <t t-out="max_file_mb"/> MB mỗi tệp.
                                </div>
                            </div>

                            <button type="submit" class="btn btn-primary px-4">Gửi hồ sơ</button>
                        </form>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- Sau khi gửi hồ sơ -->
    <template id="admission_submitted" name="Tuyển sinh: đã gửi hồ sơ">
        <t t-call="portal.portal_layout">
            <div class="container py-5 text-center" style="max-width: 620px;">
                <div class="card shadow-sm border-0" style="border-radius: 16px;">
                    <div class="card-body p-4 p-md-5">
                        <i class="fa fa-paper-plane fa-3x text-success mb-3" role="img" aria-label="Đã gửi"/>
                        <h1 class="h3">Hồ sơ của bạn đã được gửi</h1>
                        <p t-if="app" class="text-muted mb-1">
                            Mã hồ sơ: <strong t-out="app.name"/>
                        </p>
                        <p class="text-muted">
                            Nhà trường sẽ gửi email kèm nút <strong>Theo dõi hồ sơ</strong> để bạn xem lại
                            thông tin đã nộp, kết quả và trao đổi với nhà trường.
                            Nếu không thấy email, hãy kiểm tra hộp thư rác (spam).
                        </p>
                        <a href="/">Về trang chủ</a>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- Trang theo dõi hồ sơ (bố cục giống Helpdesk) -->
    <template id="portal_admission_detail" name="Tuyển sinh: theo dõi hồ sơ">
        <t t-call="portal.portal_layout">
            <div class="container o_admission_page py-5">
                <div class="row">
                    <!-- Thẻ thông tin thí sinh -->
                    <div class="col-12 col-md-4 mb-4">
                        <div class="card shadow-sm border-0" style="border-radius: 16px;">
                            <div class="card-body p-4 text-center">
                                <div class="rounded-circle bg-primary text-white d-inline-flex align-items-center justify-content-center mb-3"
                                     style="width:64px; height:64px; font-size:1.5rem;">
                                    <t t-out="(app.full_name or '?')[0].upper()"/>
                                </div>
                                <h5 class="mb-1" t-out="app.full_name"/>
                                <div t-if="app.id_number" class="text-muted small mb-1">
                                    <i class="fa fa-id-card me-1"/><t t-out="app.id_number"/>
                                </div>
                                <div t-if="app.phone" class="text-muted small mb-1">
                                    <i class="fa fa-phone me-1"/><t t-out="app.phone"/>
                                </div>
                                <div t-if="app.email" class="text-muted small">
                                    <i class="fa fa-envelope me-1"/><t t-out="app.email"/>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-md-8">
                        <!-- Nội dung hồ sơ đã nộp -->
                        <div class="card shadow-sm border-0 mb-4" style="border-radius: 16px;">
                            <div class="card-body p-4 p-md-5">
                                <div class="d-flex justify-content-between align-items-start flex-wrap mb-2 gap-2">
                                    <h1 class="h3 mb-0">
                                        Hồ sơ xét tuyển
                                        <span class="text-muted fs-6">(<t t-out="app.name"/>)</span>
                                    </h1>
                                    <span class="badge text-bg-secondary fs-6">
                                        Trạng thái: <t t-out="state_label"/>
                                    </span>
                                </div>
                                <div class="text-muted small mb-3">
                                    <t t-out="app.campaign_id.name"/> - nộp ngày <span t-field="app.create_date"/>
                                </div>

                                <!-- 4 bước -->
                                <div class="row text-center g-2 mb-4">
                                    <div t-foreach="steps" t-as="step" class="col-6 col-md-3">
                                        <div t-attf-class="p-2 rounded border small #{'bg-primary text-white' if step_index == current_step else 'bg-success-subtle' if step_index &lt; current_step else 'bg-light text-muted'}">
                                            <t t-out="step_index + 1"/>. <t t-out="step[1]"/>
                                        </div>
                                    </div>
                                </div>

                                <!-- Kết quả -->
                                <div t-if="app.state == 'done' and app.result_message"
                                     class="alert alert-success" role="alert">
                                    <h5 class="alert-heading">Kết quả hồ sơ</h5>
                                    <p class="mb-0" style="white-space: pre-line;" t-out="app.result_message"/>
                                </div>

                                <h2 class="h6 mt-4 mb-2">Thông tin cá nhân</h2>
                                <div class="bg-light rounded p-3 small">
                                    <div class="row">
                                        <div class="col-sm-6 mb-1" t-if="app.date_of_birth">Ngày sinh: <span t-field="app.date_of_birth"/></div>
                                        <div class="col-sm-6 mb-1" t-if="app.gender">Giới tính: <span t-field="app.gender"/></div>
                                        <div class="col-sm-6 mb-1" t-if="app.school_name">Trường THPT: <t t-out="app.school_name"/></div>
                                        <div class="col-sm-6 mb-1" t-if="app.graduation_year">Năm tốt nghiệp: <t t-out="app.graduation_year"/></div>
                                        <div class="col-12 mb-1" t-if="app.address">Địa chỉ: <t t-out="app.address"/></div>
                                        <div class="col-sm-6 mb-1" t-if="app.id_issue_date">Ngày cấp CCCD: <span t-field="app.id_issue_date"/></div>
                                        <div class="col-sm-6 mb-1" t-if="app.id_issue_place">Nơi cấp: <t t-out="app.id_issue_place"/></div>
                                        <div class="col-12" t-if="app.vneid_account">Tài khoản VNeID: <t t-out="app.vneid_account"/></div>
                                    </div>
                                </div>

                                <h2 class="h6 mt-4 mb-2">Nguyện vọng xét tuyển</h2>
                                <div class="table-responsive">
                                    <table class="table table-sm align-middle">
                                        <thead>
                                            <tr><th>NV</th><th>Ngành</th><th>Phương thức</th><th>Tổ hợp</th></tr>
                                        </thead>
                                        <tbody>
                                            <tr t-foreach="app.choice_ids.sorted('priority')" t-as="choice">
                                                <td t-out="choice.priority"/>
                                                <td><t t-out="choice.program_id.name"/> (<t t-out="choice.program_id.code"/>)</td>
                                                <td t-out="choice.method_id.name"/>
                                                <td t-out="choice.combination_id.name or '-'"/>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>

                                <h2 class="h6 mt-4 mb-2">Tài liệu đã nộp</h2>
                                <ul class="list-unstyled mb-0">
                                    <li t-foreach="app.document_ids" t-as="doc" class="mb-1">
                                        <i class="fa fa-paperclip me-1"/>
                                        <span class="text-muted" t-out="doc_labels[doc.doc_type]"/>:
                                        <a t-attf-href="/my/admission/#{app.id}/document/#{doc.id}/download?access_token=#{access_token}"
                                           t-out="doc.file_name"/>
                                    </li>
                                </ul>
                            </div>
                        </div>

                        <!-- Trao đổi -->
                        <div class="card shadow-sm border-0" style="border-radius: 16px;">
                            <div class="card-body p-4 p-md-5">
                                <h2 class="h5 mb-3">Trao đổi với nhà trường</h2>
                                <t t-call="portal.message_thread"/>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

</odoo>
