<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Thông báo sau thao tác -->
    <template id="portal_admission_flash" name="Portal tuyển sinh: thông báo">
        <div t-if="flash" t-attf-class="alert alert-#{flash['level']} mt-3" role="alert">
            <t t-out="flash['message']"/>
        </div>
    </template>

    <!-- Các ô thông tin cá nhân dùng chung cho form công khai và trang theo dõi (vals: dict chuỗi) -->
    <template id="admission_personal_fields" name="Tuyển sinh: ô thông tin cá nhân">
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label" for="full_name">Họ và tên</label>
                <input type="text" class="form-control" name="full_name" id="full_name" t-att-value="vals.get('full_name')" required="required"/>
            </div>
            <div class="col-md-3">
                <label class="form-label" for="date_of_birth">Ngày sinh</label>
                <input type="date" class="form-control" name="date_of_birth" id="date_of_birth" t-att-value="vals.get('date_of_birth')"/>
            </div>
            <div class="col-md-3">
                <label class="form-label" for="gender">Giới tính</label>
                <select class="form-select" name="gender" id="gender">
                    <option value="">--</option>
                    <option value="male" t-att-selected="vals.get('gender') == 'male'">Nam</option>
                    <option value="female" t-att-selected="vals.get('gender') == 'female'">Nữ</option>
                    <option value="other" t-att-selected="vals.get('gender') == 'other'">Khác</option>
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label" for="phone">Số điện thoại</label>
                <input type="tel" class="form-control" name="phone" id="phone" t-att-value="vals.get('phone')" pattern="[0-9+]{10,12}" required="required"/>
            </div>
            <div class="col-md-4">
                <label class="form-label" for="email">Email</label>
                <input type="email" class="form-control" name="email" id="email" t-att-value="vals.get('email')" required="required"/>
            </div>
            <div class="col-md-4">
                <label class="form-label" for="graduation_year">Năm tốt nghiệp THPT</label>
                <input type="number" class="form-control" name="graduation_year" id="graduation_year" t-att-value="vals.get('graduation_year')"/>
            </div>
            <div class="col-md-6">
                <label class="form-label" for="school_name">Trường THPT</label>
                <input type="text" class="form-control" name="school_name" id="school_name" t-att-value="vals.get('school_name')"/>
            </div>
            <div class="col-md-6">
                <label class="form-label" for="address">Địa chỉ liên hệ</label>
                <input type="text" class="form-control" name="address" id="address" t-att-value="vals.get('address')"/>
            </div>
            <div class="col-md-4">
                <label class="form-label" for="id_number">Số căn cước công dân (12 số)</label>
                <input type="text" class="form-control" name="id_number" id="id_number" t-att-value="vals.get('id_number')" pattern="[0-9]{12}"/>
            </div>
            <div class="col-md-4">
                <label class="form-label" for="id_issue_date">Ngày cấp</label>
                <input type="date" class="form-control" name="id_issue_date" id="id_issue_date" t-att-value="vals.get('id_issue_date')"/>
            </div>
            <div class="col-md-4">
                <label class="form-label" for="id_issue_place">Nơi cấp</label>
                <input type="text" class="form-control" name="id_issue_place" id="id_issue_place" t-att-value="vals.get('id_issue_place')"/>
            </div>
            <div class="col-md-8">
                <label class="form-label" for="vneid_account">Tài khoản VNeID (số định danh cá nhân)</label>
                <input type="text" class="form-control" name="vneid_account" id="vneid_account" t-att-value="vals.get('vneid_account')"/>
            </div>
            <div class="col-md-4">
                <label class="form-label" for="vneid_level">Mức định danh điện tử</label>
                <select class="form-select" name="vneid_level" id="vneid_level">
                    <option value="">--</option>
                    <option value="1" t-att-selected="vals.get('vneid_level') == '1'">Mức 1</option>
                    <option value="2" t-att-selected="vals.get('vneid_level') == '2'">Mức 2</option>
                </select>
            </div>
        </div>
    </template>


    <!-- Danh sách đợt tuyển sinh đang mở -->
    <template id="admission_apply_list" name="Tuyển sinh: chọn đợt đăng ký">
        <t t-call="portal.portal_layout">
            <div class="container py-5" style="max-width: 720px;">
                <h1 class="h3 mb-4">Đăng ký xét tuyển</h1>
                <div t-if="not campaigns" class="alert alert-info">Hiện chưa có đợt tuyển sinh nào đang mở nhận hồ sơ.</div>
                <div class="list-group">
                    <t t-foreach="campaigns" t-as="c">
                        <a t-attf-href="/admission/apply/#{c.admission_form_ids.filtered('active')[:1].token}"
                           class="list-group-item list-group-item-action">
                            <strong t-out="c.name"/> <span class="text-muted">(<t t-out="c.year"/>)</span>
                        </a>
                    </t>
                </div>
            </div>
        </t>
    </template>

    <template id="admission_apply_closed" name="Tuyển sinh: form đã đóng">
        <t t-call="portal.portal_layout">
            <div class="container py-5 text-center" style="max-width: 620px;">
                <div class="alert alert-warning">Form đăng ký này hiện không còn nhận hồ sơ.</div>
                <a href="/admission/apply">Xem các đợt tuyển sinh đang mở</a>
            </div>
        </t>
    </template>

    <!-- Form nộp hồ sơ công khai -->
    <template id="admission_apply_form" name="Tuyển sinh: form nộp hồ sơ">
        <t t-call="portal.portal_layout">
            <div class="container py-5" style="max-width: 860px;">
                <h1 class="h3 mb-1" t-out="form.website_title or 'Đăng ký xét tuyển'"/>
                <p class="text-muted" t-out="form.website_description"/>
                <p class="text-muted"><t t-out="form.campaign_id.name"/></p>
                <div t-if="error" class="alert alert-danger" role="alert" style="white-space: pre-line;" t-out="error"/>
                <form t-attf-action="/admission/apply/#{form.token}/submit" method="post" enctype="multipart/form-data">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <!-- Ô bẫy bot, ẩn với người dùng -->
                    <div style="position:absolute; left:-9999px;" aria-hidden="true">
                        <input type="text" name="website_url" tabindex="-1" autocomplete="off"/>
                    </div>

                    <div class="card mb-4">
                        <div class="card-header">1. Thông tin cá nhân, căn cước và VNeID</div>
                        <div class="card-body">
                            <t t-call="eaut_admission.admission_personal_fields"/>
                        </div>
                    </div>

                    <div class="card mb-4">
                        <div class="card-header">2. Nguyện vọng xét tuyển (tối đa <t t-out="max_choices"/>)</div>
                        <div class="card-body">
                            <div t-foreach="range(1, max_choices + 1)" t-as="n" class="row g-2 mb-2">
                                <div class="col-md-1 pt-2">NV<t t-out="n"/></div>
                                <div class="col-md-3">
                                    <select t-attf-name="program_id_#{n}" class="form-select">
                                        <option value="">Ngành học</option>
                                        <option t-foreach="programs" t-as="p" t-att-value="p.id"
                                                t-att-selected="vals.get('program_id_%s' % n) == str(p.id)">
                                            <t t-out="p.name"/> (<t t-out="p.code"/>)
                                        </option>
                                    </select>
                                </div>
                                <div class="col-md-3">
                                    <select t-attf-name="method_id_#{n}" class="form-select">
                                        <option value="">Phương thức</option>
                                        <option t-foreach="methods" t-as="m" t-att-value="m.id" t-out="m.name"
                                                t-att-selected="vals.get('method_id_%s' % n) == str(m.id)"/>
                                    </select>
                                </div>
                                <div class="col-md-3">
                                    <select t-attf-name="combination_id_#{n}" class="form-select">
                                        <option value="">Tổ hợp (nếu có)</option>
                                        <option t-foreach="combinations" t-as="c" t-att-value="c.id" t-out="c.name"
                                                t-att-selected="vals.get('combination_id_%s' % n) == str(c.id)"/>
                                    </select>
                                </div>
                                <div class="col-md-2">
                                    <input type="number" step="0.01" min="0" max="30" t-attf-name="score_#{n}"
                                           class="form-control" placeholder="Điểm"
                                           t-att-value="vals.get('score_%s' % n)"/>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="card mb-4">
                        <div class="card-header">3. Tài liệu (học bạ, căn cước, VNeID...)</div>
                        <div class="card-body">
                            <div t-foreach="doc_types" t-as="dt" class="mb-3">
                                <label class="form-label" t-attf-for="file_#{dt[0]}">
                                    <t t-out="dt[1]"/>
                                    <span t-if="dt[0] in ('transcript', 'id_front', 'id_back', 'vneid')" class="text-danger">*</span>
                                </label>
                                <input type="file" class="form-control" t-attf-id="file_#{dt[0]}" t-attf-name="file_#{dt[0]}"
                                       t-att-accept="allowed_extensions"
                                       t-att-multiple="None if dt[0] in single_doc_types else 'multiple'"/>
                            </div>
                            <div class="form-text">
                                Định dạng <t t-out="allowed_extensions"/>, tối đa <t t-out="max_file_mb"/> MB mỗi tệp.
                                Mục có dấu <span class="text-danger">*</span> là bắt buộc.
                            </div>
                        </div>
                    </div>

                    <div class="text-end">
                        <button type="submit" class="btn btn-success btn-lg">Gửi hồ sơ</button>
                    </div>
                </form>
            </div>
        </t>
    </template>

    <!-- Sau khi gửi hồ sơ -->
    <template id="admission_submitted" name="Tuyển sinh: đã gửi hồ sơ">
        <t t-call="portal.portal_layout">
            <div class="container py-5 text-center" style="max-width: 620px;">
                <div class="card shadow-sm border-0" style="border-radius: 16px;">
                    <div class="card-body p-4 p-md-5">
                        <i class="fa fa-paper-plane fa-3x text-success mb-3" role="img" aria-label="Đã gửi"/>
                        <h1 class="h3">Hồ sơ của bạn đã được gửi</h1>
                        <p t-if="application_name" class="text-muted mb-1">
                            Mã hồ sơ: <strong t-out="application_name"/>
                        </p>
                        <p class="text-muted" t-if="email_hint">
                            Nhà trường đã gửi email theo dõi hồ sơ tới <strong t-out="email_hint"/>.
                            Bấm nút <strong>Theo dõi hồ sơ</strong> trong email để xem trạng thái, kết quả và trao đổi với nhà trường.
                        </p>
                        <p class="text-muted small">Nếu không thấy email, hãy kiểm tra hộp thư rác (spam).</p>
                        <a href="/">Về trang chủ</a>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- Chi tiết hồ sơ -->
    <template id="portal_admission_detail" name="Portal tuyển sinh: chi tiết hồ sơ">
        <t t-call="portal.portal_layout">
            <div class="container mb-5">
                                <h3><span t-out="app.name"/> - <span t-out="app.campaign_id.name"/></h3>

                <t t-call="eaut_admission.portal_admission_flash"/>

                <!-- 4 bước trạng thái hồ sơ -->
                <div class="row text-center my-4 g-2">
                    <div t-foreach="steps" t-as="step" class="col-6 col-md-3">
                        <div t-attf-class="p-2 rounded border #{'bg-primary text-white' if step_index == current_step else 'bg-success-subtle' if step_index &lt; current_step else 'bg-light text-muted'}">
                            <div class="fw-bold"><t t-out="step_index + 1"/></div>
                            <div t-out="step[1]"/>
                        </div>
                    </div>
                </div>

                <!-- Thông báo theo trạng thái -->
                <div t-if="app.state == 'draft' and app.supplement_request" class="alert alert-warning" role="alert">
                    <strong>Nhà trường yêu cầu bổ sung:</strong>
                    <div style="white-space: pre-line;" t-out="app.supplement_request"/>
                </div>
                <div t-if="app.state == 'draft' and missing" class="alert alert-info" role="alert">
                    <strong>Hồ sơ còn thiếu:</strong>
                    <ul class="mb-0">
                        <li t-foreach="missing" t-as="item" t-out="item"/>
                    </ul>
                </div>
                <div t-if="app.state == 'completed'" class="alert alert-info" role="alert">
                    Hồ sơ của bạn đã hoàn thành và đang chờ nhà trường tiếp nhận kiểm tra.
                </div>
                <div t-if="app.state == 'reviewing'" class="alert alert-primary" role="alert">
                    Phòng đào tạo đang kiểm tra hồ sơ của bạn. Kết quả sẽ được thông báo qua email và tại trang này.
                </div>
                <div t-if="app.state == 'done' and app.result == 'accepted'" class="alert alert-success" role="alert">
                    <h5 class="alert-heading">Hồ sơ đã được nhà trường chấp nhận</h5>
                    <p style="white-space: pre-line;" t-out="app.result_message"/>
                    <hr/>
                    <p class="mb-1" t-if="app.tuition_amount">
                        Học phí cần đóng:
                        <strong t-out="app.tuition_amount" t-options="{'widget': 'monetary', 'display_currency': app.currency_id}"/>
                    </p>
                    <p class="mb-1">
                        Học phí:
                        <strong t-out="'Đã đóng' if app.payment_state == 'paid' else 'Chưa đóng'"/>
                        <t t-if="app.payment_reference"> (mã giao dịch <t t-out="app.payment_reference"/>)</t>
                    </p>
                    <p class="mb-1">
                        Tốt nghiệp THPT:
                        <strong t-out="dict(app._fields['graduation_status'].selection)[app.graduation_status]"/>
                    </p>
                    <a t-if="app.admission_letter_available" t-attf-href="/my/admission/#{app.id}/letter?access_token=#{access_token}"
                       class="btn btn-success mt-2">Tải giấy xác nhận nhập học</a>
                    <p t-else="" class="small mt-2 mb-0">
                        Giấy xác nhận nhập học sẽ được cấp khi bạn đã đóng học phí và đỗ tốt nghiệp THPT.
                    </p>
                </div>
                <div t-if="app.state == 'done' and app.result == 'rejected'" class="alert alert-danger" role="alert">
                    <h5 class="alert-heading">Hồ sơ chưa được nhà trường chấp nhận</h5>
                    <p class="mb-0" style="white-space: pre-line;" t-out="app.result_message"/>
                </div>

                <!-- 1. Thông tin cá nhân, căn cước, VNeID -->
                <form t-attf-action="/my/admission/#{app.id}/save" method="post" class="card mb-4">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
<input type="hidden" name="access_token" t-att-value="access_token"/>
                    <div class="card-header">1. Thông tin cá nhân, căn cước và VNeID</div>
                    <fieldset class="card-body" t-att-disabled="None if editable else 'disabled'">
                        <t t-call="eaut_admission.admission_personal_fields"/>
                        <button t-if="editable" type="submit" class="btn btn-primary mt-3">Lưu thông tin</button>
                    </fieldset>
                </form>

                <!-- 2. Nguyện vọng -->
                <div class="card mb-4">
                    <div class="card-header">2. Nguyện vọng xét tuyển (tối đa <t t-out="max_choices"/>)</div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-sm align-middle" t-if="app.choice_ids">
                                <thead>
                                    <tr>
                                        <th>NV</th><th>Ngành</th><th>Phương thức</th><th>Tổ hợp</th><th>Điểm khai</th><th/>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="app.choice_ids.sorted('priority')" t-as="choice">
                                        <td t-out="choice.priority"/>
                                        <td><t t-out="choice.program_id.name"/> (<t t-out="choice.program_id.code"/>)</td>
                                        <td t-out="choice.method_id.name"/>
                                        <td t-out="choice.combination_id.name or '-'"/>
                                        <td t-out="choice.score"/>
                                        <td class="text-end">
                                            <form t-if="editable" method="post"
                                                  t-attf-action="/my/admission/#{app.id}/choice/#{choice.id}/delete">
                                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
<input type="hidden" name="access_token" t-att-value="access_token"/>
                                                <button type="submit" class="btn btn-sm btn-outline-danger">Xóa</button>
                                            </form>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        <p t-if="not app.choice_ids" class="text-muted">Chưa có nguyện vọng nào.</p>

                        <form t-if="editable and len(app.choice_ids) &lt; max_choices" method="post"
                              t-attf-action="/my/admission/#{app.id}/choice/add" class="row g-2 mt-2">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
<input type="hidden" name="access_token" t-att-value="access_token"/>
                            <div class="col-md-3">
                                <select name="program_id" class="form-select" required="required">
                                    <option value="">Ngành học</option>
                                    <option t-foreach="programs" t-as="p" t-att-value="p.id">
                                        <t t-out="p.name"/> (<t t-out="p.code"/>)
                                    </option>
                                </select>
                            </div>
                            <div class="col-md-3">
                                <select name="method_id" class="form-select" required="required">
                                    <option value="">Phương thức xét tuyển</option>
                                    <option t-foreach="methods" t-as="m" t-att-value="m.id" t-out="m.name"/>
                                </select>
                            </div>
                            <div class="col-md-3">
                                <select name="combination_id" class="form-select">
                                    <option value="">Tổ hợp (nếu có)</option>
                                    <option t-foreach="combinations" t-as="c" t-att-value="c.id" t-out="c.name"/>
                                </select>
                            </div>
                            <div class="col-md-2">
                                <input type="number" step="0.01" min="0" max="30" name="score"
                                       class="form-control" placeholder="Điểm"/>
                            </div>
                            <div class="col-md-1">
                                <button type="submit" class="btn btn-outline-primary w-100">Thêm</button>
                            </div>
                        </form>
                    </div>
                </div>

                <!-- 3. Tài liệu -->
                <div class="card mb-4">
                    <div class="card-header">3. Tài liệu hồ sơ (học bạ, căn cước, VNeID...)</div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-sm align-middle" t-if="app.document_ids">
                                <thead>
                                    <tr><th>Loại giấy tờ</th><th>Tệp</th><th>Kiểm tra</th><th/></tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="app.document_ids" t-as="doc">
                                        <td t-out="dict(doc_types)[doc.doc_type]"/>
                                        <td>
                                            <a t-attf-href="/my/admission/#{app.id}/document/#{doc.id}/download?access_token=#{access_token}"
                                               t-out="doc.file_name"/>
                                        </td>
                                        <td>
                                            <span t-if="doc.check_state == 'valid'" class="badge text-bg-success">Hợp lệ</span>
                                            <span t-elif="doc.check_state == 'invalid'" class="badge text-bg-danger">
                                                Không hợp lệ<t t-if="doc.check_note">: <t t-out="doc.check_note"/></t>
                                            </span>
                                            <span t-else="" class="badge text-bg-secondary">Chờ kiểm tra</span>
                                        </td>
                                        <td class="text-end">
                                            <form t-if="editable" method="post"
                                                  t-attf-action="/my/admission/#{app.id}/document/#{doc.id}/delete">
                                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
<input type="hidden" name="access_token" t-att-value="access_token"/>
                                                <button type="submit" class="btn btn-sm btn-outline-danger">Xóa</button>
                                            </form>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        <p t-if="not app.document_ids" class="text-muted">Chưa tải lên tài liệu nào.</p>

                        <form t-if="editable" method="post" enctype="multipart/form-data"
                              t-attf-action="/my/admission/#{app.id}/upload" class="row g-2 mt-2">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
<input type="hidden" name="access_token" t-att-value="access_token"/>
                            <div class="col-md-4">
                                <select name="doc_type" class="form-select" required="required">
                                    <option value="">Loại giấy tờ</option>
                                    <option t-foreach="doc_types" t-as="dt" t-att-value="dt[0]" t-out="dt[1]"/>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <input type="file" name="file" class="form-control" required="required"
                                       t-att-accept="allowed_extensions"/>
                            </div>
                            <div class="col-md-2">
                                <button type="submit" class="btn btn-outline-primary w-100">Tải lên</button>
                            </div>
                            <div class="form-text">
                                Định dạng <t t-out="allowed_extensions"/>, tối đa <t t-out="max_file_mb"/> MB mỗi tệp.
                                Học bạ có thể tải nhiều tệp; căn cước, VNeID tải lên lại sẽ thay thế tệp cũ.
                            </div>
                        </form>
                    </div>
                </div>

                <!-- 5. Trao đổi với nhà trường -->
                <div class="card mb-4">
                    <div class="card-body">
                        <h2 class="h5 mb-3">Trao đổi với nhà trường</h2>
                        <t t-call="portal.message_thread"/>
                    </div>
                </div>

                <!-- 4. Hoàn thành hồ sơ -->
                <form t-if="editable" method="post" t-attf-action="/my/admission/#{app.id}/submit"
                      class="text-end"
                      onsubmit="return confirm('Sau khi gửi lại, bạn không thể chỉnh sửa hồ sơ cho đến khi nhà trường phản hồi. Tiếp tục?');">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
<input type="hidden" name="access_token" t-att-value="access_token"/>
                    <button type="submit" class="btn btn-success btn-lg" t-att-disabled="'disabled' if missing else None">
                        Gửi lại hồ sơ
                    </button>
                </form>
            </div>
        </t>
    </template>
</odoo>
